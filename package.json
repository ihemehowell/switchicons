{
  "name": "switch-icons",
  "version": "0.2.0",
  "description": "A lightweight, tree-shakeable React icon library — general UI icons plus West African fintech/payment-rail icons (bank transfer, USSD, POS, mobile money, and more).",
  "author": "Uchenna (Bitvora Tech / Howell Devs)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "icons",
    "react",
    "svg",
    "fintech",
    "payments",
    "africa"
  ]
}
